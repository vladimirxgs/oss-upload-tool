{
  "name": "oss-upload-tool",
  "version": "1.12.1",
  "description": "跨平台 OSS 可视化上传工具（基于 ossutil）",
  "main": "src/main/main.js",
  "author": "viktor",
  "license": "MIT",
  "scripts": {
    "prepare": "node scripts/prepare-ossutil.js",
    "start": "electron .",
